{
    "configurations": [
        {
            "type": "cppdbg",
            "request": "launch",
            "name": "run pq",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/target/debug/pq",
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "short"
                },
                {
                    "name": "RUSTC_TOOLCHAIN",
                    "value": "/Users/pebaz/.rustup/toolchains/nightly-aarch64-apple-darwin"
                }
            ],
            "args": [
                "${workspaceFolder}/json/json.json"
            ],
            "sourceFileMap": {},
            "osx": {
                "MIMode": "lldb"
            }
        }
    ]
}
